# Decision Model の API キーの見本。.env に写し、使うモデルの API キーを書く
# switch2-agent は .env を自分では読まないため、uv run --env-file .env switch2-agent ... で実行する

# TypeSafe Jev (--model jev)
TYPESAFE_API_KEY=

# OpenAI Decisions API (--model decisions)
OPENAI_API_KEY=

# Google AI Studio API (Gemini Decisions 1)
GOOGLE_AI_STUDIO_API_KEY=
