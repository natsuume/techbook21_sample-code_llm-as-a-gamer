# Decision Model の API キーと、この PC の機材の値の見本。.env に写し、使うモデルの API キーと、この PC の機材の値を書く
# switch2-agent は .env を自分では読まないため、uv run --env-file .env switch2-agent ... で実行する

# TypeSafe Jev (--model jev)
TYPESAFE_API_KEY=

# OpenAI Decisions API (--model decisions)
OPENAI_API_KEY=

# Google AI Studio API (Gemini Decisions 1)
GOOGLE_AI_STUDIO_API_KEY=

# この PC の機材の値。起動引数 --com-port・--device-fps を省いたときに使う。空なら COM3・60
SWITCH2_COM_PORT=
SWITCH2_DEVICE_FPS=
